@{
    ViewData["Title"] = "Volunteer";
}

<!-- VOLUNTEER HERO -->
<section class="volunteer-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="hero-label">
                    JOIN THE RELIEF EFFORT
                </span>

                <h1>
                    Give Your Time.
                    <span>Make a Difference.</span>
                </h1>

                <p>
                    Volunteers play an important role in supporting
                    humanitarian relief projects. Register your interest
                    and let us know how you can help.
                </p>

            </div>

            <div class="col-lg-5 text-center">

                <div class="volunteer-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- VOLUNTEER FORM -->
<section class="volunteer-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="volunteer-form-card">

                    <div class="text-center mb-4">

                        <span class="section-label">
                            VOLUNTEER REGISTRATION
                        </span>

                        <h2>
                            Register Your Interest
                        </h2>

                        <p>
                            Complete the form below and tell us how
                            you would like to contribute.
                        </p>

                    </div>


                    <form>

                        <!-- NAME -->

                        <div class="mb-4">

                            <label class="form-label">
                                Full Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter your full name">

                        </div>


                        <!-- EMAIL -->

                        <div class="mb-4">

                            <label class="form-label">
                                Email Address
                            </label>

                            <input type="email"
                                   class="form-control"
                                   placeholder="Enter your email address">

                        </div>


                        <!-- PHONE -->

                        <div class="mb-4">

                            <label class="form-label">
                                Phone Number
                            </label>

                            <input type="tel"
                                   class="form-control"
                                   placeholder="Enter your phone number">

                        </div>


                        <!-- SKILLS -->

                        <div class="mb-4">

                            <label class="form-label">
                                Skills
                            </label>

                            <textarea class="form-control"
                                      rows="4"
                                      placeholder="Tell us about your skills or experience"></textarea>

                        </div>


                        <!-- AVAILABILITY -->

                        <div class="mb-4">

                            <label class="form-label">
                                Availability
                            </label>

                            <select class="form-select">

                                <option selected>
                                    Select your availability
                                </option>

                                <option>
                                    Weekdays
                                </option>

                                <option>
                                    Weekends
                                </option>

                                <option>
                                    Both weekdays and weekends
                                </option>

                                <option>
                                    Emergency response only
                                </option>

                            </select>

                        </div>


                        <!-- VOLUNTEER AREA -->

                        <div class="mb-4">

                            <label class="form-label">
                                Area of Interest
                            </label>

                            <select class="form-select">

                                <option selected>
                                    Select an area
                                </option>

                                <option>
                                    Food Distribution
                                </option>

                                <option>
                                    Medical Assistance
                                </option>

                                <option>
                                    Emergency Relief
                                </option>

                                <option>
                                    Community Support
                                </option>

                                <option>
                                    Administration
                                </option>

                            </select>

                        </div>


                        <!-- AGREEMENT -->

                        <div class="form-check mb-4">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="volunteerAgreement">

                            <label class="form-check-label"
                                   for="volunteerAgreement">

                                I agree to be contacted regarding
                                volunteer opportunities.

                            </label>

                        </div>


                        <!-- SUBMIT -->

                        <button type="button"
                                class="btn btn-primary-custom w-100">

                            <i class="bi bi-person-plus-fill me-2"></i>

                            Register as a Volunteer

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- VOLUNTEER BENEFITS -->

<section class="volunteer-benefits">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-label">
                WHY VOLUNTEER?
            </span>

            <h2>
                Your Contribution Matters
            </h2>

        </div>


        <div class="row g-4 mt-4">

            <div class="col-md-4">

                <div class="value-card">

                    <i class="bi bi-heart-fill"></i>

                    <h4>
                        Help Communities
                    </h4>

                    <p>
                        Support people and communities affected
                        by emergencies and disasters.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="value-card">

                    <i class="bi bi-people-fill"></i>

                    <h4>
                        Work Together
                    </h4>

                    <p>
                        Become part of a community of people
                        working together to create positive change.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="value-card">

                    <i class="bi bi-stars"></i>

                    <h4>
                        Make an Impact
                    </h4>

                    <p>
                        Use your skills, experience and time to
                        contribute to meaningful humanitarian work.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>