@{
    ViewData["Title"] = "Project Details";
}

<!-- PROJECT DETAILS HEADER -->
<section class="project-details-header">

    <div class="container">

        <a asp-controller="Projects"
           asp-action="Index"
           class="back-link">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Relief Projects

        </a>

        <div class="row align-items-center mt-4">

            <div class="col-lg-7">

                <span class="project-status-large">
                    ONGOING PROJECT
                </span>

                <h1>
                    Gauteng Flood Relief
                </h1>

                <p class="project-location">

                    <i class="bi bi-geo-alt-fill me-2"></i>

                    Gauteng, South Africa

                </p>

            </div>

            <div class="col-lg-5">

                <img src="https://images.unsplash.com/photo-1547683905-f686c993aae5?auto=format&fit=crop&w=900&q=80"
                     alt="Gauteng Flood Relief"
                     class="project-details-image">

            </div>

        </div>

    </div>

</section>


<!-- PROJECT INFORMATION -->
<section class="project-information">

    <div class="container">

        <div class="row g-5">

            <!-- MAIN CONTENT -->
            <div class="col-lg-8">

                <span class="section-label">
                    ABOUT THIS PROJECT
                </span>

                <h2>
                    Providing Emergency Support
                </h2>

                <p>
                    The Gauteng Flood Relief project provides emergency
                    assistance to communities affected by severe flooding.
                    The project focuses on providing essential resources
                    to families who have been displaced or affected.
                </p>

                <p>
                    Relief teams work with volunteers and community
                    organisations to distribute food, clean water,
                    hygiene supplies and other essential resources.
                </p>


                <!-- PROJECT OBJECTIVES -->

                <h3 class="details-heading">
                    Project Objectives
                </h3>

                <div class="objective-list">

                    <div class="objective-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Provide emergency food supplies.
                        </span>

                    </div>

                    <div class="objective-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Provide clean drinking water.
                        </span>

                    </div>

                    <div class="objective-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Support displaced families.
                        </span>

                    </div>

                    <div class="objective-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Coordinate community volunteers.
                        </span>

                    </div>

                </div>


                <!-- LATEST UPDATE -->

                <h3 class="details-heading">
                    Latest Project Update
                </h3>

                <div class="update-card">

                    <div class="update-header">

                        <div>

                            <strong>
                                Relief distribution completed
                            </strong>

                            <small>
                                Posted by Employee
                            </small>

                        </div>

                        <span>
                            18 Aug 2026
                        </span>

                    </div>

                    <p>
                        Our relief team successfully distributed food
                        parcels and clean water to affected families.
                        Additional supplies are being prepared for the
                        next distribution.
                    </p>

                </div>

            </div>


            <!-- SIDEBAR -->
            <div class="col-lg-4">

                <div class="project-sidebar">

                    <h4>
                        Project Progress
                    </h4>

                    <div class="progress project-details-progress">

                        <div class="progress-bar"
                             style="width: 70%;">
                        </div>

                    </div>

                    <div class="progress-info">

                        <strong>
                            70%
                        </strong>

                        <span>
                            Completed
                        </span>

                    </div>


                    <hr>


                    <div class="project-stat">

                        <i class="bi bi-people-fill"></i>

                        <div>

                            <strong>
                                45
                            </strong>

                            <span>
                                Volunteers
                            </span>

                        </div>

                    </div>


                    <div class="project-stat">

                        <i class="bi bi-box-seam-fill"></i>

                        <div>

                            <strong>
                                850+
                            </strong>

                            <span>
                                Relief Packages
                            </span>

                        </div>

                    </div>


                    <div class="project-stat">

                        <i class="bi bi-calendar-event"></i>

                        <div>

                            <strong>
                                August 2026
                            </strong>

                            <span>
                                Started
                            </span>

                        </div>

                    </div>


                    <a href="#"
                       class="btn btn-primary-custom w-100 mt-4">

                        <i class="bi bi-heart-fill me-2"></i>

                        Support This Project

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>