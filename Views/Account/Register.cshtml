@{
    ViewData["Title"] = "Register";
}

<section class="account-section">

    <div class="container">

        <div class="account-card register-card">

            <div class="account-header text-center">

                <div class="account-icon">
                    <i class="bi bi-person-plus-fill"></i>
                </div>

                <span class="section-label">
                    JOIN OUR COMMUNITY
                </span>

                <h1>Create an Account</h1>

                <p>
                    Register to support humanitarian relief efforts.
                </p>

            </div>


            <form>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            First Name
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="First name">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Last Name
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Last name">

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Email Address
                        </label>

                        <input type="email"
                               class="form-control"
                               placeholder="Enter your email">

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Password
                        </label>

                        <input type="password"
                               class="form-control"
                               placeholder="Create a password">

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Account Type
                        </label>

                        <select class="form-select">

                            <option selected>
                                Select account type
                            </option>

                            <option>
                                Donor
                            </option>

                            <option>
                                Employee
                            </option>

                        </select>

                    </div>


                    <div class="col-12">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="terms">

                            <label class="form-check-label"
                                   for="terms">

                                I agree to the terms and conditions.

                            </label>

                        </div>

                    </div>


                    <div class="col-12">

                        <button type="button"
                                class="btn btn-primary-custom w-100">

                            <i class="bi bi-person-plus-fill me-2"></i>

                            Create Account

                        </button>

                    </div>

                </div>

            </form>


            <div class="account-divider">
                <span>OR</span>
            </div>


            <div class="text-center">

                <p>
                    Already have an account?
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="account-link">

                    Login

                </a>

            </div>

        </div>

    </div>

</section>