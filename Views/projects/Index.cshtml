<!-- PROJECT CTA -->
<section class="projects-cta">

    <div class="container text-center">

        <h2>
            Want to Support a Relief Project?
        </h2>

        <p>
            Your donation or volunteer contribution can help
            humanitarian teams continue their work.
        </p>

        <div class="mt-4">

            <a asp-controller="Donation"
               asp-action="Index"
               class="btn btn-primary-custom">

                <i class="bi bi-heart-fill me-2"></i>

                Donate Now

            </a>

            <a asp-controller="Volunteer"
               asp-action="Index"
               class="btn btn-outline-custom">

                <i class="bi bi-people-fill me-2"></i>

                Become a Volunteer

            </a>

        </div>

    </div>

</section>