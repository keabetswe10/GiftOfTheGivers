@{
    ViewData["Title"] = "Relief Projects";
}

<!-- PAGE HEADER -->
<section class="projects-header">

    <div class="container text-center">

        <span class="section-label">
            OUR HUMANITARIAN WORK
        </span>

        <h1>
            Relief Projects
        </h1>

        <p>
            Explore ongoing humanitarian projects and discover
            how communities are receiving support.
        </p>

    </div>

</section>


<!-- PROJECTS -->
<section class="projects-list-section">

    <div class="container">

        <div class="row g-4">

            <!-- PROJECT 1 -->
            <div class="col-lg-4 col-md-6">

                <div class="project-card">

                    <div class="project-image">

                        <img src="https://images.unsplash.com/photo-1547683905-f686c993aae5?auto=format&fit=crop&w=700&q=80"
                             alt="Flood relief">

                        <span class="project-status">
                            Ongoing
                        </span>

                    </div>

                    <div class="project-content">

                        <small>
                            <i class="bi bi-geo-alt"></i>
                            Gauteng, South Africa
                        </small>

                        <h4>
                            Gauteng Flood Relief
                        </h4>

                        <p>
                            Providing emergency food, clean water
                            and essential supplies to communities
                            affected by flooding.
                        </p>

                        <div class="project-progress">

                            <div class="progress">

                                <div class="progress-bar"
                                     style="width: 70%;">
                                </div>

                            </div>

                            <small>
                                Project progress: 70%
                            </small>

                        </div>

                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="1"
                           class="project-link">

                            View Project
                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- PROJECT 2 -->
            <div class="col-lg-4 col-md-6">

                <div class="project-card">

